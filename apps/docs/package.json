    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto": "^5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/start-static-server-functions": "1.167.37",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "lucide-react": "^1.47.0",
