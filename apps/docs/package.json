    "nitro": "3.0.260903-beta",
    "shadcn": "4.21.0",
    "srvx": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
