        { "text": "Woche", "start": 25.332, "end": 25.552 },
        { "text": "wäre", "start": 25.552, "end": 25.772 },
        { "text": "außerdem", "start": 25.772, "end": 26.212 },
        { "text": "Montag", "start": 26.212, "end": 26.542 },
        { "text": "früh", "start": 26.542, "end": 26.762 },
