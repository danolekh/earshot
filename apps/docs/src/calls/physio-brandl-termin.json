      ],
      "start": 0.3,
      "end": 6.248,
      "id": "t0",
      "text": "Physiotherapie Brandl, guten Tag. Hier spricht die digitale Assistentin. Wie kann ich Ihnen helfen?"
    },
    {
      "role": "user",
      "speaker": "Thomas Huber",
      "words": [
        { "text": "Grüß", "start": 6.874, "end": 7.141 },
        { "text": "Gott,", "start": 7.164, "end": 7.784 },
        { "text": "ich", "start": 7.784, "end": 8.014 },
        { "text": "bräuchte", "start": 8.014, "end": 8.604 },
        { "text": "einen", "start": 8.604, "end": 9.024 },
        { "text": "Termin.", "start": 9.024, "end": 9.774 },
        { "text": "Ich", "start": 9.774, "end": 10.004 },
        { "text": "habe", "start": 10.004, "end": 10.144 },
        { "text": "seit", "start": 10.144, "end": 10.374 },
        { "text": "einer", "start": 10.374, "end": 10.664 },
        { "text": "Woche", "start": 10.664, "end": 10.964 },
        { "text": "Rückenschmerzen.", "start": 10.964, "end": 12.064 }
      ],
      "start": 6.848,
      "end": 12.087,
      "id": "t1",
      "text": "Grüß Gott, ich bräuchte einen Termin. Ich habe seit einer Woche Rückenschmerzen."
    },
    {
      "role": "agent",
      "speaker": "Assistentin",
      "words": [
        { "text": "Das", "start": 12.814, "end": 12.974 },
        { "text": "tut", "start": 12.974, "end": 13.174 },
        { "text": "mir", "start": 13.174, "end": 13.374 },
        { "text": "leid.", "start": 13.374, "end": 13.774 },
        { "text": "Haben", "start": 13.774, "end": 13.954 },
        { "text": "Sie", "start": 13.954, "end": 14.054 },
        { "text": "eine", "start": 14.054, "end": 14.194 },
        { "text": "Überweisung", "start": 14.194, "end": 14.614 },
        { "text": "von", "start": 14.614, "end": 14.814 },
        { "text": "Ihrem", "start": 14.814, "end": 15.134 },
        { "text": "Arzt,", "start": 15.134, "end": 15.434 },
        { "text": "oder", "start": 15.434, "end": 15.584 },
        { "text": "möchten", "start": 15.584, "end": 15.884 },
        { "text": "Sie", "start": 15.884, "end": 16.034 },
        { "text": "privat", "start": 16.034, "end": 16.304 },
        { "text": "kommen?", "start": 16.304, "end": 16.774 }
      ],
      "start": 12.787,
      "end": 17.65,
      "id": "t2",
      "text": "Das tut mir leid. Haben Sie eine Überweisung von Ihrem Arzt, oder möchten Sie privat kommen?"
    },
    {
      "role": "user",
      "speaker": "Thomas Huber",
      "words": [
        { "text": "Ich", "start": 18.169, "end": 18.419 },
        { "text": "habe", "start": 18.419, "end": 18.779 },
        { "text": "eine", "start": 18.779, "end": 19.139 },
        { "text": "Überweisung,", "start": 19.139, "end": 20.189 },
        { "text": "ja.", "start": 20.189, "end": 20.309 }
      ],
      "start": 18.15,
      "end": 20.301,
      "id": "t3",
      "text": "Ich habe eine Überweisung, ja."
    },
    {
      "role": "agent",
      "speaker": "Assistentin",
      "words": [
        { "text": "Sehr", "start": 21.232, "end": 21.392 },
        { "text": "gut.", "start": 21.392, "end": 21.642 },
