    "endOfTurn": 0.35,
    "llmTtft": 0.295,
    "tool": 0.35,
    "ttsTtfb": 0.14
   },
   "replyTo": "t1",
   "speechId": "speech_confirm",
   "start": 12.590125,
   "text": "Alles klar. Die Zustellung ist für morgen zwischen vierzehn und achtzehn Uhr geplant. Brauchen Sie sonst noch etwas?"
  },
  {
   "channel": "caller",
   "confidence": 0.95,
   "end": 20.744083,
   "id": "t3",
   "latency": {
    "endOfTurn": 0.35,
    "transcription": 0.18
   },
   "start": 19.135125,
   "text": "Nein, das war alles."
  },
  {
   "channel": "agent",
